---
// Paper card with a red bookmark ribbon, linking to a series page.
import { SERIES, type SeriesId } from '../consts';
import { seriesPosts } from '../utils/series';

interface Props {
	id: SeriesId;
}
const { id } = Astro.props;
const count = (await seriesPosts(id)).length;
---

{
	count > 0 && (
		<a class="series-box" href={`/series/${id}/`}>
			<span class="ribbon" aria-hidden="true">系列</span>
			<strong>{SERIES[id].title}</strong>
			<span class="sub">共 {count} 篇，建议按顺序读</span>
		</a>
	)
}

<style>
	.series-box {
		position: relative;
		display: block;
		padding: 1.6rem 2rem 1.4rem 4.4rem;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: var(--bg);
		text-decoration: none;
		box-shadow:
			6px 6px 0 -1px var(--bg),
			6px 6px 0 0 var(--rule);
		transition: border-color 0.2s;
	}
	.series-box:hover {
		border-color: var(--accent);
		color: inherit;
	}
	.ribbon {
		position: absolute;
		top: -1px;
		left: 1.4rem;
		width: 1.8rem;
		padding: 0.6rem 0 1.3rem;
		background: var(--accent);
		color: var(--on-accent);
		writing-mode: vertical-rl;
		font-family: 'Display SC', var(--font-serif);
		font-weight: 900;
		font-size: 0.9rem;
		letter-spacing: 0.4em;
		line-height: 1.8rem;
		text-align: center;
		clip-path: polygon(0 0, 100% 0, 100% 100%, 50% calc(100% - 0.65rem), 0 100%);
	}
	strong {
		display: block;
		margin-bottom: 0.3rem;
		font-family: var(--font-serif);
		font-size: 1.55rem;
		line-height: 1.3;
		word-break: keep-all;
		transition: color 0.2s;
	}
	.series-box:hover strong {
		color: var(--accent);
	}
	.sub {
		font-size: 0.9rem;
		color: var(--ink-faint);
	}
	@media (max-width: 560px) {
		.series-box {
			padding: 1.4rem 1.2rem 1.2rem 3.9rem;
		}
		.ribbon {
			left: 1.1rem;
		}
	}
</style>
