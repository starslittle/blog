---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a class="brand" href="/">
		<span class="seal" aria-hidden="true">念</span>
		<span class="name">{SITE_TITLE}</span>
	</a>
	<nav aria-label="主导航">
		<HeaderLink href="/">首页</HeaderLink>
		<HeaderLink href="/blog">文章</HeaderLink>
		<HeaderLink href="/about">关于</HeaderLink>
		<button class="theme-toggle" type="button" aria-label="切换深色模式">
			<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
			</svg>
			<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
					></path>
				</g>
			</svg>
		</button>
	</nav>
</header>
<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--ink);
	}
	.seal {
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		background: var(--accent);
		color: var(--on-accent);
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.15rem;
		line-height: 1;
		border-radius: 5px;
		transform: rotate(-5deg);
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.brand:hover .seal {
		transform: rotate(4deg) scale(1.06);
	}
	.name {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.15rem;
		letter-spacing: 0.02em;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.4rem;
		font-size: 0.95rem;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin: 0 -0.4rem 0 -0.3rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: none;
		color: var(--ink-soft);
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s,
			transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1);
	}
	.theme-toggle:hover {
		color: var(--accent);
		background: var(--surface);
		transform: rotate(20deg);
	}
	/* The icon shows what a click switches to. No JS means no data-theme: hide the button. */
	:global(:root:not([data-theme])) .theme-toggle,
	:global(:root[data-theme='dark']) .moon,
	:global(:root:not([data-theme='dark'])) .sun {
		display: none;
	}
	@media (max-width: 420px) {
		nav {
			gap: 1rem;
		}
	}
</style>

<script>
	const root = document.documentElement;
	const label = () => (root.dataset.theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
	for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
		button.setAttribute('aria-label', label());
		button.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {}
			button.setAttribute('aria-label', label());
		});
	}
</script>
