---
import Layout from '../layouts/BlogPost.astro';

const experience = [
	{
		period: '2026.05 – 2026.08',
		place: '字节跳动 · 豆包（飞书）',
	},
	{
		period: '2025.12 – 2026.04',
		place: 'Karis',
	},
	{
		period: '2025.03 – 2025.07',
		place: '同花顺',
	},
];

const openSource = [
	{
		name: 'OpenViking',
		href: 'https://github.com/volcengine/OpenViking',
		text: '面向 Agent 的上下文数据库。我重构了其中一个插件的记忆召回链路。',
	},
	{
		name: 'DeerFlow',
		href: 'https://github.com/bytedance/deer-flow',
		text: '修了跨域部署下的鉴权问题，以及 Memory 配置的启动期校验。',
	},
	{
		name: 'Resume-Agent',
		href: 'https://github.com/kkooww77/Resume-Agent',
		text: '我自己的项目：用自然语言生成简历的 AI 平台。',
	},
];
---

<Layout title="关于" description="Tao 是谁，做过什么，这个博客写什么。">
	<p class="lead">
		你好，我是 Tao，做 AI 应用开发，也写全栈。
	</p>
	<p>
		比起训练模型，我更关心怎么让模型在真实产品里稳定地把事情做完：检索要召回对的东西，Agent
		出错了要知道停下来，上线之前要有评测兜底。
	</p>

	<h2>做过的事</h2>
	<ol class="timeline">
		{
			experience.map((item) => (
				<li>
					<span class="period">{item.period}</span>
					<span class="place">{item.place}</span>
				</li>
			))
		}
	</ol>

	<h2>开源与项目</h2>
	<p>我喜欢在用到的开源项目里顺手修问题，也自己做点东西。</p>
	<dl class="projects">
		{
			openSource.map((item) => (
				<>
					<dt>
						<a href={item.href}>{item.name}</a>
					</dt>
					<dd>{item.text}</dd>
				</>
			))
		}
	</dl>

	<h2>这个博客</h2>
	<p>
		这里是我的碎碎念：工作里刚解决的问题、用着顺手的工具、还没想清楚的想法。不求完整，只求写下来。
	</p>
</Layout>

<style>
	.lead {
		font-size: 1.12em;
		color: var(--ink);
	}
	.timeline {
		list-style: none;
		margin: 0 0 1.2em;
		padding: 0;
		text-align: left;
	}
	.timeline li {
		display: grid;
		grid-template-columns: 10.5rem 1fr;
		gap: 0 1rem;
		align-items: baseline;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.period {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink-faint);
	}
	.place {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.1rem;
	}
	@media (max-width: 600px) {
		.timeline li {
			grid-template-columns: 1fr;
		}
	}
	.projects {
		margin: 0 0 1.2em;
		text-align: left;
	}
	.projects dt {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.1rem;
	}
	.projects dd {
		margin: 0.2rem 0 1.2rem;
		color: var(--ink-soft);
	}
</style>
