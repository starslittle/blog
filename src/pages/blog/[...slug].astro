---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { SERIES } from '../../consts';
import { readingMinutes } from '../../utils/reading-time';
import { seriesPosts } from '../../utils/series';

export async function getStaticPaths() {
	// Newest first, the same order as the post list.
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			// "上一篇" is the older post, "下一篇" the newer one.
			prev: posts[i + 1] && { href: `/blog/${posts[i + 1].id}/`, title: posts[i + 1].data.title },
			next: posts[i - 1] && { href: `/blog/${posts[i - 1].id}/`, title: posts[i - 1].data.title },
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: { href: string; title: string };
	next?: { href: string; title: string };
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const seriesId = post.data.series;
const series = seriesId && {
	title: SERIES[seriesId].title,
	href: `/series/${seriesId}/`,
	parts: (await seriesPosts(seriesId)).map((p) => ({
		title: p.data.title,
		href: `/blog/${p.id}/`,
		current: p.id === post.id,
	})),
};
---

<BlogPost
	{...post.data}
	headings={headings}
	minutes={readingMinutes(post.body ?? '')}
	ogImage={`/og/${post.id}.png`}
	seriesInfo={series || undefined}
	prev={prev}
	next={next}
>
	<Content />
</BlogPost>

