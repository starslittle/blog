---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SERIES, SITE_DESCRIPTION, SITE_TITLE, type SeriesId } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const series = (Object.keys(SERIES) as SeriesId[])
	.map((id) => ({ id, ...SERIES[id], count: posts.filter((p) => p.data.series === id).length }))
	.filter((s) => s.count > 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.series-list {
				display: grid;
				gap: 0.75rem;
				margin: 0 0 2.5rem;
			}
			.series-card {
				display: block;
				padding: 1rem 1.2rem;
				border: 1px solid var(--rule);
				border-left: 3px solid var(--accent);
				border-radius: 8px;
				text-decoration: none;
				line-height: 1.6;
				transition: border-color 0.15s;
			}
			.series-card:hover {
				border-color: var(--accent);
				color: inherit;
			}
			.series-card small {
				display: block;
				font-size: 0.8rem;
				letter-spacing: 0.15em;
				color: var(--ink-faint);
			}
			.series-card strong {
				font-family: var(--font-serif);
				font-size: 1.15rem;
			}
			.series-card span {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.9rem;
				color: var(--ink-soft);
			}
			.count {
				margin-bottom: 2rem;
				color: var(--ink-faint);
				font-size: 0.92rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>文章</h1>
			{
				series.length > 0 && (
					<div class="series-list">
						{series.map((s) => (
							<a class="series-card" href={`/series/${s.id}/`}>
								<small>系列 · {s.count} 篇</small>
								<strong>{s.title} →</strong>
								<span>{s.description}</span>
							</a>
						))}
					</div>
				)
			}
			<p class="count">共 {posts.length} 篇，按时间倒序。</p>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
