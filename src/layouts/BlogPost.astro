---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Comments from '../components/Comments.astro';
import { SITE_TITLE } from '../consts';

type Link = { href: string; title: string };
type Series = { title: string; href: string; parts: (Link & { current: boolean })[] };
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate'> & {
	pubDate?: Date;
	headings?: MarkdownHeading[];
	minutes?: number;
	/** Share card path; pages without one (like 关于) use the site card. */
	ogImage?: string;
	/** Named seriesInfo so it isn't confused with the `series` id in the frontmatter. */
	seriesInfo?: Series;
	prev?: Link;
	next?: Link;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	minutes,
	ogImage,
	seriesInfo: series,
	prev,
	next,
} =
	Astro.props;

const seriesIndex = series ? series.parts.findIndex((p) => p.current) + 1 : 0;
const CN = ['', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
const pad = (n: number) => String(n).padStart(2, '0');
const stamp = (d: Date) => `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Only h2/h3 go in the table of contents, and only when there are enough to help.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={ogImage}
			type={pubDate ? 'article' : 'website'}
		/>
		<style>
			article {
				position: relative;
				max-width: var(--measure);
				margin-inline: auto;
			}
			/* With room for the TOC column, line the text up with the header's left edge. */
			@media (min-width: 66rem) {
				article {
					margin-left: 0;
				}
			}
			.title {
				margin-bottom: 2.75rem;
			}
			.kicker {
				margin: 0 0 1rem;
				font-size: 0.85rem;
				letter-spacing: 0.2em;
				color: var(--accent);
			}
			.kicker a {
				text-decoration: none;
			}
			.kicker a:hover {
				text-decoration: underline;
			}
			.title h1 {
				margin: 0 0 1.1rem;
				font-size: clamp(2.1rem, 5.5vw, 3rem);
				line-height: 1.3;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.3rem 1.2rem;
				margin: 0;
				font-size: 0.88rem;
				color: var(--ink-faint);
			}
			.meta time {
				font-family: var(--font-newsreader), Georgia, serif;
				font-style: italic;
				font-size: 1.02rem;
			}
			/* A short red rule closing the title block, instead of a full-width line */
			.title::after {
				content: '';
				display: block;
				width: 2.5rem;
				height: 2px;
				margin-top: 1.6rem;
				background: var(--accent);
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin-bottom: 2.5rem;
			}

			/* Table of contents: a folded box above the text on narrow screens,
			   a sticky column beside the text on wide ones. */
			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 0.86rem;
				line-height: 1.5;
			}
			.toc-list li {
				margin: 0;
			}
			.toc-list a {
				display: block;
				padding: 0.3rem 0 0.3rem 0.85rem;
				border-left: 2px solid var(--rule);
				color: var(--ink-faint);
				text-decoration: none;
				transition:
					color 0.15s,
					border-color 0.15s;
			}
			.toc-list .depth-3 a {
				padding-left: 1.85rem;
			}
			.toc-list a:hover {
				color: var(--ink);
			}
			.toc-list a.active {
				color: var(--ink);
				border-left-color: var(--accent);
			}
			.toc-label {
				margin: 0 0 0.6rem;
				font-size: 0.78rem;
				letter-spacing: 0.2em;
				color: var(--ink-faint);
			}

			.toc-inline {
				margin: 0 0 2.25rem;
				padding: 0.1rem 0 0.1rem 1rem;
				border-left: 2px solid var(--rule);
			}
			.toc-inline summary {
				cursor: pointer;
				font-size: 0.9rem;
				color: var(--ink-soft);
			}
			.toc-inline[open] summary {
				margin-bottom: 0.6rem;
			}
			.toc-side {
				display: none;
			}
			@media (min-width: 66rem) {
				.toc-inline {
					display: none;
				}
				.toc-side {
					display: block;
					position: absolute;
					top: 0;
					bottom: 0;
					left: calc(100% + 3.5rem);
					width: min(13rem, calc(100vw - var(--measure) - 7.5rem));
				}
				.toc-side nav {
					position: sticky;
					top: 2.5rem;
					max-height: calc(100vh - 5rem);
					overflow-y: auto;
				}
			}

			/* Reading progress along the top edge, and a back-to-top button. */
			.progress {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 20;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left;
				pointer-events: none;
			}
			.to-top {
				position: fixed;
				right: max(1.25rem, env(safe-area-inset-right));
				bottom: max(1.25rem, env(safe-area-inset-bottom));
				z-index: 20;
				display: grid;
				place-items: center;
				width: 2.4rem;
				height: 2.4rem;
				padding: 0;
				border: 1px solid var(--rule);
				border-radius: 4px;
				background: var(--bg);
				color: var(--ink-soft);
				cursor: pointer;
				opacity: 0;
				visibility: hidden;
				transform: translateY(8px);
				transition:
					opacity 0.2s,
					transform 0.2s,
					visibility 0.2s,
					color 0.15s,
					border-color 0.15s;
			}
			.to-top.show {
				opacity: 1;
				visibility: visible;
				transform: none;
			}
			.to-top:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.to-top svg {
				width: 1.1rem;
				height: 1.1rem;
			}

			/* End of text: a small seal, the way old books close a chapter */
			.fin {
				margin: 3rem 0 0;
				text-align: center;
			}
			.fin span {
				display: inline-grid;
				place-items: center;
				width: 1.9rem;
				height: 1.9rem;
				border-radius: 5px 3px 6px 4px;
				background: var(--accent);
				color: var(--on-accent);
				font-family: 'Display SC', var(--font-serif);
				font-weight: 900;
				font-size: 1.25rem;
				line-height: 1;
				transform: rotate(-6deg);
			}

			/* Older / newer post: two plain links under a rule */
			.pager {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				margin: 2.5rem 0 0;
				padding-top: 1.4rem;
				border-top: 1px solid var(--rule);
			}
			.pager a {
				display: block;
				text-decoration: none;
				line-height: 1.55;
			}
			.pager .newer {
				grid-column: 2;
				text-align: right;
			}
			.pager small {
				display: block;
				margin-bottom: 0.25rem;
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				color: var(--ink-faint);
			}
			.pager span {
				font-family: var(--font-serif);
				font-weight: 600;
				transition: color 0.2s;
			}
			.pager a:hover span {
				color: var(--accent);
			}
			@media (max-width: 600px) {
				.pager {
					grid-template-columns: 1fr;
				}
				.pager .newer {
					grid-column: auto;
					text-align: left;
				}
			}
			.back {
				margin: 2rem 0 0;
				font-size: 0.95rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="title">
					{
						pubDate && (
							<p class="kicker">
								{series ? (
									<a href={series.href}>
										{series.title} · 第{CN[seriesIndex] ?? seriesIndex}篇
									</a>
								) : (
									'碎碎念'
								)}
							</p>
						)
					}
					<h1>{title}</h1>
					{
						pubDate && (
							<p class="meta">
								<time datetime={pubDate.toISOString()}>{stamp(pubDate)}</time>
								{minutes && <span>约 {minutes} 分钟</span>}
								{updatedDate && <span>改于 {stamp(updatedDate)}</span>}
							</p>
						)
					}
				</div>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1280} height={640} src={heroImage} alt="" />
						</div>
					)
				}
				{
					showToc && (
						<details class="toc-inline">
							<summary>目录</summary>
							<ul class="toc-list">
								{toc.map((h) => (
									<li class={`depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</details>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{
					pubDate && (
						<p class="fin" aria-hidden="true">
							<span>念</span>
						</p>
					)
				}
				{pubDate && <ShareButtons title={title} url={pageUrl} />}
				{
					(prev || next) && (
						<nav class="pager" aria-label="上一篇和下一篇">
							{prev && (
								<a class="older" href={prev.href}>
									<small>← 上一篇</small>
									<span>{prev.title}</span>
								</a>
							)}
							{next && (
								<a class="newer" href={next.href}>
									<small>下一篇 →</small>
									<span>{next.title}</span>
								</a>
							)}
						</nav>
					)
				}
				{pubDate && <p class="back"><a href="/blog">← 全部文章</a></p>}
				{pubDate && <Comments />}
				{
					showToc && (
						<aside class="toc-side">
							<nav aria-label="目录">
								<p class="toc-label">目录</p>
								<ul class="toc-list">
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</nav>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
		{
			pubDate && (
				<>
					<div class="progress" aria-hidden="true" />
					<button type="button" class="to-top" aria-label="回到顶部">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M12 19V5M5 12l7-7 7 7"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
					<script>
						const bar = document.querySelector<HTMLElement>('.progress')!;
						const top = document.querySelector<HTMLButtonElement>('.to-top')!;
						const onScroll = () => {
							const max = document.documentElement.scrollHeight - innerHeight;
							bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
							top.classList.toggle('show', scrollY > innerHeight * 1.2);
						};
						addEventListener('scroll', onScroll, { passive: true });
						addEventListener('resize', onScroll, { passive: true });
						onScroll();
						top.addEventListener('click', () => scrollTo({ top: 0 }));
					</script>
				</>
			)
		}
		{
			showToc && (
				<script>
					// Highlight the section being read: the last heading that has scrolled
					// past the top fifth of the window.
					const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-list a')];
					const heads = [...new Set(links.map((a) => decodeURIComponent(a.hash.slice(1))))]
						.map((id) => document.getElementById(id))
						.filter((el): el is HTMLElement => el !== null);
					// Browsers already fire scroll at most once per frame, so no extra throttling.
					const update = () => {
						const line = innerHeight * 0.2;
						let current: string | null = null;
						for (const h of heads) {
							if (h.getBoundingClientRect().top <= line) current = h.id;
							else break;
						}
						// At the very bottom the last heading may never reach the line.
						const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
						if (atBottom && heads.length && heads.at(-1)!.getBoundingClientRect().top < innerHeight) {
							current = heads.at(-1)!.id;
						}
						for (const a of links) {
							a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === current);
						}
					};
					addEventListener('scroll', update, { passive: true });
					addEventListener('resize', update, { passive: true });
					update();
				</script>
			)
		}
	</body>
</html>
